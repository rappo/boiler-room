# ======================
# Boiler Room - .gitignore
# ======================

# ----- Secrets & Credentials -----
*.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
secrets/
credentials/
config.yaml
!agent/internal/config/config.go
*.secret
api_keys.txt
token.txt

# ----- Go -----
# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
boiler-room-agent
agent/boiler-room-agent

# Test artifacts
*.test
*.out
coverage.txt
coverage.html
*.coverprofile

# Go workspace
go.work
go.work.sum

# Vendor (if used)
vendor/

# Build output
dist/
build/
out/

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl

# Virtual environments
.venv/
venv/
ENV/
env/

# Python tools
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# ----- IDE / Editors -----
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# ----- OS -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----- Docker -----
docker-compose.override.yml

# ----- GitHub -----
# Don't ignore workflow files
!.github/

# ----- Project Specific -----
# Local test configs
test_config.yaml
local_config.yaml
*.local.yaml

# Release artifacts
*.tar.gz
*.zip
release/
